#!/usr/bin/env python3
"""Run a device package: device-adapter ID ADDRESS NAME UUIDS_JSON BLE MODEL_ID."""
import argparse
import json
from pathlib import Path
import sys

sys.dont_write_bytecode = True
from adapter_api import profiles, runtime


def main():
    runtime.arm_parent_death()
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("id")
    parser.add_argument("address")
    parser.add_argument("name")
    parser.add_argument("uuids")
    parser.add_argument("ble_address")
    parser.add_argument("model_id")
    parser.add_argument("--capture", type=Path)
    args = parser.parse_args()
    recorder = None
    try:
        if not profiles.SLUG.fullmatch(args.id) or not profiles.ADDRESS.fullmatch(args.address):
            raise ValueError("invalid device id or Bluetooth address")
        directory = profiles.ROOT / "devices" / args.id
        if not directory.resolve().is_relative_to((profiles.ROOT / "devices").resolve()):
            raise ValueError("device package escapes devices/")
        profile = profiles.load(directory)
        uuids = json.loads(args.uuids)
        if not isinstance(uuids, list) or not all(isinstance(u, str) for u in uuids):
            raise ValueError("UUIDS_JSON must be a string array")
        if not profiles.match_profile(profile, args.name, uuids, args.model_id):
            raise ValueError("device identity does not match its profile")
        if profile["adapter"]["transport"] == "ble" and not profiles.ADDRESS.fullmatch(args.ble_address):
            raise ValueError("BLE adapter needs the address announced by Fast Pair")
        if args.capture:
            recorder = runtime.Recorder(args.capture, {
                "apiVersion": 1, "device": args.id, "name": args.name, "address": args.address,
                "uuids": uuids, "modelId": args.model_id, "bleAddress": args.ble_address,
                "adapter": profile["adapter"],
                "boundary": "client-line" if profile["adapter"].get("builtin") == "jbl" else "stream",
                "implementation": profiles.implementation_hash(profile, directory)})
        context = runtime.Context(profile, directory, args.address, args.name, uuids,
                                  args.ble_address, args.model_id, recorder)
    except (ValueError, OSError, KeyError, TypeError) as error:
        runtime.emit({"modes": False, "error": str(error)})
        return 4
    try:
        return runtime.run(context)
    except KeyboardInterrupt:
        return 0
    except (BrokenPipeError,):
        return 0
    except Exception as error:
        runtime.emit({"modes": False, "error": "%s: %s" % (type(error).__name__, error)})
        return 1
    finally:
        if recorder:
            recorder.close()


if __name__ == "__main__":
    sys.exit(main())
