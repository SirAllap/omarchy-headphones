#!/usr/bin/env python3
"""Test this checkout's adapter on your headphones and retain an owner session."""
import argparse
import json
from pathlib import Path
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from omaphones import migration


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--adapter', required=True, choices=('sony', 'jbl', 'samsung', 'xiaomi', 'oppo', 'bose', 'nothing', 'soundcore'))
    parser.add_argument('--session', type=Path, required=True)
    parser.add_argument('--ble-address', default='')
    parser.add_argument('--model-id', default='')
    parser.add_argument('--automatic', action='store_true', help='adapter controls only; physical actions remain untested')
    parser.add_argument('--interview', choices=('terminal', 'json', 'web'), default='terminal')
    parser.add_argument('--owner-timeout', type=float, default=180, help='maximum seconds for each owner response')
    args = parser.parse_args()
    report = migration.run(args.adapter, args.session.resolve(), ble_address=args.ble_address,
                           model_id=args.model_id, interactive=not args.automatic,
                           interview_mode=args.interview, owner_timeout=args.owner_timeout)
    if args.interview == 'json':
        print(json.dumps({'type': 'test-result', 'version': 1, 'report': report}), flush=True)
    else:
        print(json.dumps(report, indent=2))
    return 0 if report['passed'] else 1


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (ValueError, OSError, KeyError, TypeError) as error:
        print('test-refactor:', error, file=sys.stderr)
        sys.exit(1)
