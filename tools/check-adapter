#!/usr/bin/env python3
"""Check the adapter boundary and run package tests and API pins."""
import argparse
from pathlib import Path
import sys
import unittest
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from omaphones.checking import suite_for

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("adapter", nargs="?")
parser.add_argument("--include-drafts", action="store_true")
args = parser.parse_args()
try:
    suite = suite_for(args.adapter, include_drafts=args.include_drafts)
    if args.adapter in (None, 'sony', 'jbl'):
        suite.addTests(unittest.defaultTestLoader.loadTestsFromName('tests.adapter_api_test'))
    result = unittest.TextTestRunner(verbosity=1).run(suite)
    raise SystemExit(0 if result.wasSuccessful() else 1)
except (ValueError, OSError, KeyError, TypeError) as error:
    parser.exit(1, str(error) + "\n")
